# Tiger Data PostgreSQL connection URI (server-only). TLS certificates are verified.
# Copy the connection string from your Tiger Cloud service; URL-encode special password characters.
TIGER_DATABASE_URL=

# Nessie sandbox. The market pool account receives cleared trade funds.
NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_POOL_ACCOUNT_ID=

# ANS registry. Official V1 endpoints match the committed registrations.
# ANS_API_KEY can also contain key:secret as used by ans-cli.
ANS_BASE_URL=https://api.ote-godaddy.com
ANS_API_KEY=
ANS_API_SECRET=

# Demo/control settings. These never bypass security checks.
ADMIN_DEMO_KEY=change-me
MATERIAL_EVENT_WINDOW_MINUTES=60
